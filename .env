OPENAI_API_KEY=
MODEL_NAME="qwen2.5:7b-instruct-q4_K_M" # set any of these models - (llama3, gpt-4o-mini, qwen2.5:7b)
MODEL_FALLBACK=qwen2.5:3b
TEMPERATURE=0.0
 
# Ollama perf settings
OLLAMA_BASE_URL=http://localhost:11434
KEEP_ALIVE=-1m       # keep model in VRAM between requests (eliminates cold-start)
NUM_CTX=2048        # smaller context window = faster KV-cache
 
# RAG
VECTOR_DB_PATH=vectorstore
RAG_THRESHOLD=0.80  # queries above this score skip the LLM entirely